<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Карточки по Физике – Законы Ньютона</title>
  <style>
    body {
      font-family: sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      background: #f0f4f8;
    }

    h1 {
      margin-bottom: 20px;
    }

    .card-container {
      perspective: 1000px;
      width: 300px;
      height: 200px;
    }

    .card {
      width: 100%;
      height: 100%;
      background: white;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      transition: transform 0.6s;
      transform-style: preserve-3d;
      position: relative;
    }

    .card.flipped {
      transform: rotateY(180deg);
    }

    .card-side {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      box-sizing: border-box;
      border-radius: 15px;
    }

    .front {
      background: #fff;
    }

    .back {
      background: #dff6ff;
      transform: rotateY(180deg);
    }

    .controls {
      margin-top: 20px;
      display: flex;
      gap: 10px;
    }

    button {
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      background: #0077cc;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #005fa3;
    }
  </style>
</head>
<body>
  <h1>Законы Ньютона</h1>
  <div class="card-container">
    <div class="card" id="flashcard">
      <div class="card-side front" id="card-front"></div>
      <div class="card-side back" id="card-back"></div>
    </div>
  </div>
  <div class="controls">
    <button onclick="prevCard()">Назад</button>
    <button onclick="nextCard()">Вперёд</button>
  </div>

  <script>
    const flashcards = [
      {
        question: "Что такое первый закон Ньютона?",
        answer: "Тело сохраняет состояние покоя или равномерного движения, если на него не действуют силы."
      },
      {
        question: "Что описывает второй закон Ньютона?",
        answer: "Ускорение тела пропорционально силе и обратно пропорционально массе: F = ma."
      },
      {
        question: "В чём суть третьего закона Ньютона?",
        answer: "На каждое действие есть равное и противоположное противодействие."
      }
    ];

    let currentCard = 0;
    const card = document.getElementById('flashcard');
    const front = document.getElementById('card-front');
    const back = document.getElementById('card-back');

    function updateCard() {
      front.textContent = flashcards[currentCard].question;
      back.textContent = flashcards[currentCard].answer;
      card.classList.remove('flipped');
    }

    function nextCard() {
      currentCard = (currentCard + 1) % flashcards.length;
      updateCard();
    }

    function prevCard() {
      currentCard = (currentCard - 1 + flashcards.length) % flashcards.length;
      updateCard();
    }

    card.addEventListener('click', () => {
      card.classList.toggle('flipped');
    });

    // Инициализация
    updateCard();
  </script>
</body>
</html>
